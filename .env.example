# URL of the deployed Cloudflare Worker relay (see worker/). Required: without it, the app shows
# API error messages instead of a catalog/programme/showtimes — there is no offline fallback.
VITE_API_PROXY_URL=https://cine-planner-relay.yoursubdomain.workers.dev

# Supabase project (see README "Compte et sauvegarde"). Required for accounts and saving data
# (preferences, seen films, planning history) — without them, the app still works but nothing is
# ever saved (one-shot planning only).
VITE_SUPABASE_URL=https://yourproject.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
